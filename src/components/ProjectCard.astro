---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project">
  <div class="carousel" data-carousel>
    {
      project.images.map((image, index) => (
        <img
          class:list={{ "is-active": index === 0 }}
          src={image.src}
          alt={image.alt}
          loading={index === 0 ? "eager" : "lazy"}
        />
      ))
    }
  </div>
  <div class="project-body">
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <div class="project-meta">
      <ul class="tech">
        {project.tech.map((item) => <li><img src={item.src} alt={item.alt} /></li>)}
      </ul>
      {
        project.href ? (
          <a class="source" href={project.href} rel="noreferrer">
            Source
          </a>
        ) : (
          <span class="source source-disabled">Private</span>
        )
      }
    </div>
  </div>
</article>
