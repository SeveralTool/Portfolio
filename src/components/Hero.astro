---
import Icon from "./Icon.astro";
---

<header class="hero" id="top">
  <div class="hero-social">
    <a class="icon-link" href="https://github.com/SeveralTool" aria-label="GitHub" rel="noreferrer">
      <Icon name="github" />
    </a>
    <a
      class="icon-link"
      href="https://www.linkedin.com/in/severaltool/"
      aria-label="LinkedIn"
      rel="noreferrer"
    >
      <Icon name="linkedin" />
    </a>
  </div>
  <h1>Nahuel Galeano</h1>
  <p class="role">Self-taught Software Engineer.</p>
  <p class="role">AI-first development.</p>

  <div class="actions">
    <a class="button" href="https://www.linkedin.com/in/severaltool/" rel="noreferrer">
      <Icon name="linkedin" />
      LinkedIn
    </a>
  </div>
  <a class="scroll-cue" href="#about" aria-label="Go to about">
    <Icon name="arrow" />
  </a>
</header>
