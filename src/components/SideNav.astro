---
import Icon from "./Icon.astro";
---

<nav class="rail" aria-label="Sections">
  <span class="rail-marker" id="rail-marker" aria-hidden="true"></span>
  <a href="#top" aria-label="Home" aria-current="true">
    <Icon name="home" id="icon-nav-1" class="rail-icon is-active" />
  </a>
  <span class="rail-line is-active" id="hr1"></span>
  <a href="#about" aria-label="About">
    <Icon name="user" id="icon-nav-2" class="rail-icon" />
  </a>
  <span class="rail-line" id="hr2"></span>
  <a href="#skills" aria-label="Stack">
    <Icon name="stack" id="icon-nav-3" class="rail-icon" />
  </a>
  <span class="rail-line" id="hr3"></span>
  <a href="#work" aria-label="Work">
    <Icon name="work" id="icon-nav-4" class="rail-icon" />
  </a>
</nav>

<script>
  import { initNav } from "../scripts/nav";
  initNav();
</script>
